{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gokapi Desktop",
  "version": "0.1.0",
  "identifier": "io.github.blackhornet74.gokapi-desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Gokapi Desktop",
        "width": 780,
        "height": 700,
        "minWidth": 640,
        "minHeight": 560,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "category": "Utility",
    "shortDescription": "Share files through your Gokapi server",
    "longDescription": "Gokapi Desktop is a small cross-platform client to create expiring file shares on a self-hosted Gokapi instance.",
    "copyright": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/blackhornet74/gokapi-desktop/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU4RUU4MTBDMzc1RjZERDcKUldUWGJWODNESUh1NkcvbDVBM2pKaUNLK0JmQXZ5MUNZbmRJcjVsbnI4VUlSbUgrL2VqMERrNFkK"
    }
  }
}
